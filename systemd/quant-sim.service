[Unit]
Description=Quant Sim Web (astock)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astock
Group=astock
WorkingDirectory=/home/astock/.dsh/dsh_wechat/quant
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/astock/.dsh/dsh_wechat/quant/quant_sim.py
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
