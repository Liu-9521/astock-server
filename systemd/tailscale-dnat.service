[Unit]
Description=DNAT dsh-web 3100 for Tailscale clients
After=tailscaled.service dsh-web.service
Wants=tailscaled.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'sysctl -w net.ipv4.conf.all.route_localnet=1 >/dev/null; iptables -t nat -C PREROUTING -i tailscale0 -p tcp --dport 3100 -j DNAT --to-destination 192.168.0.104:3100 2>/dev/null || iptables -t nat -A PREROUTING -i tailscale0 -p tcp --dport 3100 -j DNAT --to-destination 192.168.0.104:3100'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
